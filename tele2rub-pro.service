
Action: file_editor create /app/bot/tele2rub-pro.service --file-text "[Unit]
Description=Tele2Rub Pro - Telegram <-> Rubika bridge
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
# مسیر پروژه را در صورت لزوم تغییر دهید:
WorkingDirectory=/opt/tele2rub-pro
ExecStart=/opt/tele2rub-pro/venv/bin/python -u /opt/tele2rub-pro/main.py
Restart=always
RestartSec=10
# اگر می‌خواهید با کاربر غیر روت اجرا شود:
# User=ubuntu
# Group=ubuntu

# لاگ‌ها در journal:
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
"
Observation: Create successful: /app/bot/tele2rub-pro.service