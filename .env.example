
Action: file_editor create /app/bot/.env.example --file-text "# ========= Telegram =========
# از https://my.telegram.org بگیر
API_ID=
API_HASH=
# توکن بات تلگرام از @BotFather
BOT_TOKEN=

# ========= Rubika =========
# نام فایل سشن (در پوشه sessions/ ذخیره می‌شود). اولین اجرا شماره و کد می‌خواهد.
RUBIKA_SESSION=rubika_main
# شناسه (object_guid) چنل خصوصی روبیکا که فایل‌ها در آن آپلود می‌شوند (با c0 شروع می‌شود)
# اگر خالی بگذارید بعداً از داخل ربات با /setchannel تنظیم می‌کنید.
RUBIKA_STORAGE_CHANNEL_GUID=
# یوزرنیم پابلیک اکانت روبیکا (بدون @). به کاربر همراه کد یونیک ارسال می‌شود.
RUBIKA_ACCOUNT_USERNAME=

# ========= MongoDB =========
MONGO_URL=mongodb://localhost:27017
DB_NAME=tele2rub_pro

# ========= Admins =========
# لیست شناسه‌های عددی تلگرامِ ادمین‌ها با کاما جدا کنید (شناسه‌ها را از @userinfobot بگیرید)
ADMIN_IDS=
